# Base de Datos PostgreSQL
DB_NAME=banco_alimentos_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# Puertos expuestos
PORT_BACKEND=3000
PORT_FRONTEND=5173
PORT_SWAGGER=8080

# Seguridad OIDC / JWT (Configurar con una clave criptográfica de 64 caracteres)
JWT_SECRET=cambiar_por_clave_segura_de_64_caracteres_minimo
JWT_EXPIRES_IN=3600s
OIDC_ISSUER=https://oidc.bancodealimentos.gob.ar
OIDC_AUDIENCE=banco-de-alimentos-api
