cabal-version:      2.4
name:               padron-provincial
version:            0.1.0.0
synopsis:           API REST mock del padron provincial de comedores
build-type:         Simple

executable padron-provincial
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base >=4.14 && <5
                    , aeson >=2.0
                    , scotty >=0.12 && <0.23
                    , text
                    , http-types
    default-language: Haskell2010
    ghc-options:      -Wall -O2 -threaded